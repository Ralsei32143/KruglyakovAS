<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Тип задания"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#2D2D2D"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnTaskType1"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Обход и осмотр"
        android:textColor="#E31E24"
        android:backgroundTint="@android:color/white"
        android:textAllCaps="false"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnTaskType2"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Ремонт"
        android:textColor="#E31E24"
        android:backgroundTint="@android:color/white"
        android:textAllCaps="false"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnTaskType3"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Монтаж оборудования"
        android:textColor="#E31E24"
        android:backgroundTint="@android:color/white"
        android:textAllCaps="false"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnTaskType4"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Уборка"
        android:textColor="#E31E24"
        android:backgroundTint="@android:color/white"
        android:textAllCaps="false"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Приоритет"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#2D2D2D"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btnPriorityLow"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Низкий"
            android:textColor="#E31E24"
            android:backgroundTint="@android:color/white"
            android:textAllCaps="false"
            android:layout_marginRight="8dp"/>

        <Button
            android:id="@+id/btnPriorityHigh"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Высокий"
            android:textColor="#E31E24"
            android:backgroundTint="@android:color/white"
            android:textAllCaps="false"
            android:layout_marginLeft="8dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Выбрать"
        android:textColor="@android:color/white"
        android:backgroundTint="#E31E24"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"/>

</LinearLayout>