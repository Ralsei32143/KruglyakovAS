<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="РЖД"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#E31E24"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvBrigadeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Бригада: Восточная"
            android:textSize="16sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Текущее задание"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#2D2D2D"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvTaskTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Задание: Ремонт пути, участок 3"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#E31E24"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Статус выполнения"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2D2D2D"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnInWork"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="В работе"
            android:textColor="#E31E24"
            android:backgroundTint="@android:color/white"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:layout_marginRight="8dp"/>

            <Button
                android:id="@+id/btnCompleted"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Выполнено"
            android:textColor="#666666"
            android:backgroundTint="@android:color/white"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:layout_marginLeft="8dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Обнаружены проблемы"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2D2D2D"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <CheckBox
                android:id="@+id/cbProblem1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Износ рельс/шпал"
                android:textColor="#2D2D2D"
                android:layout_marginBottom="8dp"/>

            <CheckBox
                android:id="@+id/cbProblem2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Загрязнение путей"
                android:textColor="#2D2D2D"
                android:layout_marginBottom="8dp"/>

            <CheckBox
                android:id="@+id/cbProblem3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Повреждение оборудования"
                android:textColor="#2D2D2D"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Дополнительные комментарии"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2D2D2D"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etComment"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Введите комментарий..."
            android:gravity="top"
            android:padding="12dp"
            android:background="@android:color/white"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0/1000"
            android:gravity="right"
            android:textColor="#999999"
            android:textSize="12sp"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Отправить отчет"
            android:textColor="@android:color/white"
            android:backgroundTint="#E31E24"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>